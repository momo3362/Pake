# Copiez ce fichier en .env et renseignez vos cles.
# .env est ignore par git : il ne doit JAMAIS etre versionne ni colle dans le canal.
#
# Creation de la cle : Binance > Profil > Gestion API > Creer une API
#   - NE PAS cocher "Activer le Trading Spot & Margin"
#   - NE PAS cocher "Activer les retraits"
#   - Cocher uniquement la lecture
#   - Restreindre l'acces aux IP de confiance (sinon Binance expire la cle a 90 jours)
# L'agent refuse de demarrer si la cle porte le droit de trading.

BINANCE_API_KEY=
BINANCE_API_SECRET=
